include README.md
include LICENSE
include CMakeLists.txt
include pyproject.toml
include setup.py

recursive-include flash_kmeans_cuda/csrc *.cpp *.cu *.cuh *.h
recursive-include cmake *.in
recursive-include docs *.md
recursive-include benchmarks *.py
recursive-include tests *.py

prune .autotune
prune .triton_cache
prune .pytest_cache
prune .venv
prune build
prune build-shared
prune dist
prune flash_kmeans_cuda.egg-info

global-exclude __pycache__ *.py[cod] *.log *.pyd *.so *.dylib *.dll *.lib *.exp *.obj *.o *.pdb
